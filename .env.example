# Copiaza acest fisier in .env si completeaza cu cheile tale.
# Daca lasi totul necompletat, aplicatia ruleaza in mod OFFLINE (fallback local,
# keyword-matching) -- perfect pentru demo fara conexiune sau chei.

# Optiunea A: Azure OpenAI
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini

# Optiunea B: OpenAI standard (daca nu ai Azure)
OPENAI_API_KEY=
